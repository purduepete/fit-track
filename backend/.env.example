# fittrack backend configuration (copy to backend/.env and fill in secrets).
# Reuses the existing webportfolio Azure SQL server; tables live in the `fit`
# schema of the WebPortfolio database.

DB_SERVER=sqlgkhw25ijhyzzy.database.windows.net
DB_NAME=WebPortfolio
DB_SCHEMA=fit
DB_ENCRYPT=true

# Authentication mode:
#   aad = Azure AD token via DefaultAzureCredential (RECOMMENDED). Locally this
#         uses your `az login`; in Azure it uses the app's managed identity.
#         No password needed — leave DB_USER/DB_PASSWORD blank.
#   sql = username/password (set DB_USER + DB_PASSWORD below).
DB_AUTH=aad
DB_USER=sqladmin
DB_PASSWORD=

# ODBC driver name (must match the installed driver).
# Windows: "ODBC Driver 18 for SQL Server"
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Athlete profile for VO2 max interpretation (optional). Age + sex are required
# to map a VO2 max number to a fitness category on the dashboard; leave blank to
# show the bare value with no interpretation.
ATHLETE_BIRTH_DATE=
ATHLETE_SEX=
