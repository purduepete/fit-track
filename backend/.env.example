# Fit Track backend configuration (copy to backend/.env for local runs).

# The app's PostgreSQL database. Production reads this from the protected app.env.
DATABASE_URL=postgresql+psycopg://sd_fittrack_runtime:<password>@127.0.0.1:5432/fit_track
DB_SCHEMA=public

# Athlete profile for VO2 max interpretation (optional). Age + sex are required
# to map a VO2 max number to a fitness category on the dashboard; leave blank to
# show the bare value with no interpretation.
ATHLETE_BIRTH_DATE=
ATHLETE_SEX=

# Optional personal Strava importer. Authorize with scripts\Connect-Strava.ps1.
# Keep the credential file outside the repository in a protected strava directory.
STRAVA_TOKEN_FILE=
STRAVA_POLL_SECONDS=900